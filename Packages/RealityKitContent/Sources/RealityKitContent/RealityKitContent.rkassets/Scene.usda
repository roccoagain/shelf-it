#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "Root"
{
    reorder nameChildren = ["Sphere", "GridMaterial"]
    rel material:binding = None (
        bindMaterialAs = "weakerThanDescendants"
    )

    def "GridMaterial" (
        active = true
        references = @Materials/GridMaterial.usda@
    )
    {
        float3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    def "ShelfPrototype" (
        active = true
        customData = {
            float3 rotationEulerHint = (-1.568372, 0, 0)
        }
        prepend references = @ShelfPrototype.usdc@
    )
    {
        quatf xformOp:orient = (0.70796335, -0.7062491, 0, 0)
        float3 xformOp:scale = (0.43479478, 0.4347948, 0.4347948)
        float3 xformOp:translate = (2.7241184e-8, -0.36281168, -0.0008794209)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "Cube"
        {
            over "Cube" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </Root/ShelfPrototype/Cube/Cube/MaplePlywood> (
                    bindMaterialAs = "weakerThanDescendants"
                )

                def "MaplePlywood" (
                    active = true
                    prepend references = @MaplePlywood.usdz@
                )
                {
                }
            }
        }

        def RealityKitComponent "Collider"
        {
            uint group = 1
            uniform token info:id = "RealityKit.Collider"
            uint mask = 4294967295
            token type = "Default"

            def RealityKitStruct "Shape"
            {
                float3 extent = (2, 0.99999994, 1)
                token shapeType = "Box"

                def RealityKitStruct "pose"
                {
                    float3 position = (0, 0, 0.5)
                }
            }
        }
    }
}

